{
  "name": "qrcode",
  "description": "QRCode / 2d Barcode api with both server side and client side support using canvas",
  "version": "2.0.0",
  "keywords": [
    "qr",
    "code",
    "canvas",
    "qrcode"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "browser": {
    "./lib/index.js": "./lib/browser.js",
    "fs": false
  },
  "files": [
    "bin",
    "build",
    "lib",
    "helper",
    "src"
  ],
  "homepage": "http://github.com/soldair/node-qrcode",
  "license": "MIT",
  "scripts": {
    "clean": "node -e \"for (const d of ['lib', 'helper', 'bin', 'build', '.cache']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "check:node": "tsx tools/node-version/check-node-version.ts",
    "build:ts": "pnpm run check:node && tsx tools/compile-check/check-compiled-outputs.ts && tsc -b src",
    "build:bundle": "rollup -c rollup.config.ts --configPlugin \"sucrase={transforms:['typescript']}\"",
    "build": "pnpm run build:ts && pnpm run build:bundle",
    "typecheck": "tsx tools/compile-check/check-compiled-outputs.ts && tsc -b",
    "watch": "tsc -b --watch",
    "lint": "eslint --cache --cache-location .cache/eslint/ .",
    "pretest": "pnpm run check:node && pnpm run lint && pnpm run typecheck",
    "test": "tap",
    "migration-check": "pnpm run build && tsx tools/migration-check/src/reference.ts .cache/migration-check/reference.json && tsx tools/migration-check/src/snapshot.ts . .cache/migration-check/candidate.json && tsx tools/migration-check/src/compare.ts .cache/migration-check/reference.json .cache/migration-check/candidate.json tools/migration-check/expected-differences.json",
    "package-check": "tsx tools/package-check/src/package-check.ts",
    "ci": "pnpm test && pnpm run migration-check && pnpm run package-check",
    "prepack": "pnpm run clean && pnpm run build",
    "browser": "pnpm run build && node examples/clientsideserver.mts"
  },
  "bin": {
    "qrcode": "./bin/qrcode.js"
  },
  "dependencies": {
    "dijkstrajs": "^1.0.3",
    "pngjs": "^7.0.0",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.9.0",
    "@babel/preset-env": "^7.9.5",
    "@napi-rs/canvas": "1.1.0",
    "@rollup/plugin-commonjs": "^22.0.2",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "@rollup/plugin-sucrase": "^4.0.4",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/sinon": "^9.0.11",
    "@types/tap": "^15.0.12",
    "@types/yargs": "^17.0.35",
    "browserify": "^16.5.1",
    "canvasutil": "0.0.4",
    "colors": "^1.4.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "express": "^4.17.1",
    "htmlparser2": "^4.1.0",
    "neostandard": "0.13.0",
    "rollup": "^2.79.2",
    "rollup-plugin-babel": "^4.4.0",
    "rollup-plugin-sourcemaps": "0.6.3",
    "rollup-plugin-terser": "^5.3.0",
    "sinon": "^9.0.2",
    "source-map": "0.7.5",
    "source-map-support": "0.5.21",
    "tap": "^16.2.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/soldair/node-qrcode.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@10.34.5"
}
